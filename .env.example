# OnboardOps local development configuration

# FastAPI MCP server
ONBOARDOPS_MCP_PORT=8765
ONBOARDOPS_DEMO_REPO_PATH=
ONBOARDOPS_DEMO_REPO=rohan879/OnboardOps

# Optional GitHub API token for PR and incident lookups.
# Use a fine-grained token with contents:read and metadata:read.
ONBOARDOPS_GITHUB_TOKEN=

# Next.js dashboard
NEXT_PUBLIC_MCP_WS_URL=ws://127.0.0.1:8765/events
NEXT_PUBLIC_REPOSITORY_URL=https://github.com/rohan879/OnboardOps
NEXT_PUBLIC_REPOSITORY_BRANCH=main
